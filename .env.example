# Browser (public): Meta Pixel / dataset ID, embedded in the client bundle
VITE_META_PIXEL_ID=

# --- Ingest path ---
# Set both of these to route leads through n8n. Leave them empty to run the
# pipeline in process instead (see "Ingest paths" in the README).

# Server only: n8n Lead Intake production webhook URL
N8N_WEBHOOK_URL=
# Server only: shared secret sent in the X-LeadRelay-Secret header
N8N_WEBHOOK_SECRET=

# --- Storage ---

# Server only: Airtable base ID (starts with "app")
AIRTABLE_BASE_ID=
# Server only: Airtable token (scope: data.records:write)
AIRTABLE_TOKEN=

# --- Conversions API (in-process path only; n8n holds its own credentials) ---

# Server only: Meta dataset (pixel) ID
META_PIXEL_ID=
# Server only: Conversions API access token
META_CAPI_TOKEN=
# Server only: Graph API version. Defaults to v24.0 when empty
META_GRAPH_VERSION=
# Server only: set only while verifying events in Meta Events Manager
META_TEST_EVENT_CODE=

# --- Alerts ---

# Server only: Slack incoming webhook URL for operational alerts
SLACK_WEBHOOK_URL=

# Setup script only (scripts/setup-airtable.mjs): scopes schema.bases:read, schema.bases:write
AIRTABLE_SETUP_TOKEN=
